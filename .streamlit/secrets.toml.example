# Copy this file to .streamlit/secrets.toml (on your own computer) or paste its content into
# Streamlit Community Cloud > your app > Settings > Secrets. NEVER upload secrets.toml to GitHub.

# Your Anthropic API key (starts with sk-ant-). Optional: without it, each visitor pastes their own key.
ANTHROPIC_API_KEY = "sk-ant-..."

# Strongly recommended on a public app: only people who know this password can use the key above.
APP_PASSWORD = "choose-a-long-password"
